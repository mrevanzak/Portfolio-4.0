---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "./Photo.astro";
import type { DetailBlock, PortfolioItem } from "../lib/content";

// Notion language names are Shiki ids; Code falls back to plaintext for any it doesn't know.
type CodeLang = ComponentProps<typeof Code>["lang"];

// Tint whole +/- lines so a diff reads like a PR view, not just coloured text.
// --i is the line's position among changed lines, which staggers the sweep-in.
const isChange = (text: string | undefined): text is string => text?.[0] === "+" || text?.[0] === "-";
const diffLines: ComponentProps<typeof Code>["transformers"] = [
  {
    line(node, line) {
      const lines = this.source.split("\n");
      const text = lines[line - 1];
      if (!isChange(text)) return;
      this.addClassToHast(node, text[0] === "+" ? "diff-add" : "diff-remove");
      node.properties.style = `--i: ${lines.slice(0, line - 1).filter(isChange).length}`;
    }
  }
];

interface Props {
  item: PortfolioItem;
}

const { item } = Astro.props as Props;
const description = item.summary ?? `${item.kind === "writing" ? "Writing" : "Work"} by Rev.`;
const blocks: DetailBlock[] = item.body?.length ? item.body : item.summary ? [{ type: "paragraph", text: item.summary }] : [];
// Same photo that sits on top of the index stack (the first image), so the hero morph lands on it.
const heroImage = item.images?.[0];
---

<BaseLayout title={`${item.title} — Rev`} description={description} image={{ src: `/og${item.href}.png`, alt: `${item.title}: ${description}` }}>
  <main class="detail-shell route-enter-shell" data-route-shell data-route-view="detail" data-route-kind={item.kind} data-astro-transition-scope={`detail-${item.kind}`}>
    <a class="back-chevron" href="/" aria-label="Back" data-back-mode="detail">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <polyline points="11.5 15.25 5.25 9 11.5 2.75" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
      </svg>
    </a>

    <article class="detail-page">
      {heroImage && (
        <figure class="detail-hero">
          <Photo src={heroImage.src} widths={[480, 960, 1440]} sizes="min(481px, calc(100vw - 69px))" alt={heroImage.alt ?? ""} decoding="async" fetchpriority="high" />
        </figure>
      )}

      <header class="detail-header stagger-in" style="--delay: 40ms">
        <p class="detail-kicker">{item.kind}</p>
        <h1>{item.title}</h1>
        <p class="detail-meta">{item.date}{item.summary ? ` — ${item.summary}` : ""}</p>
      </header>

      <div class="detail-divider" aria-hidden="true"></div>

      <section class="detail-body stagger-in" style="--delay: 120ms" aria-label={`${item.title} content`}>
        {blocks.map((block: DetailBlock, index) => (
          <>
            {block.type === "paragraph" && (
              <p class="detail-block" style={`--item-delay: ${index * 70}ms`}>{block.text}</p>
            )}

            {block.type === "heading" && block.level === 2 && (
              <h2 class="detail-block" style={`--item-delay: ${index * 70}ms`} data-level={block.level}>{block.text}</h2>
            )}

            {block.type === "heading" && block.level === 3 && (
              <h3 class="detail-block" style={`--item-delay: ${index * 70}ms`} data-level={block.level}>{block.text}</h3>
            )}

            {block.type === "bulleted-list" && (
              <ul class="detail-block detail-list" style={`--item-delay: ${index * 70}ms`}>
                {block.items.map((itemText) => <li>{itemText}</li>)}
              </ul>
            )}

            {block.type === "numbered-list" && (
              <ol class="detail-block detail-list" style={`--item-delay: ${index * 70}ms`}>
                {block.items.map((itemText) => <li>{itemText}</li>)}
              </ol>
            )}

            {block.type === "quote" && (
              <blockquote class="detail-block" style={`--item-delay: ${index * 70}ms`}>
                <p>{block.text}</p>
              </blockquote>
            )}

            {block.type === "divider" && <hr class="detail-rule detail-block" style={`--item-delay: ${index * 70}ms`} />}

            {block.type === "code" && (
              <figure class="detail-block detail-code" style={`--item-delay: ${index * 70}ms`} data-diff={block.language === "diff" ? "" : undefined}>
                <Code code={block.code} lang={block.language as CodeLang} themes={{ light: "github-light", dark: "github-dark" }} transformers={block.language === "diff" ? diffLines : undefined} />
                {block.caption && <figcaption>{block.caption}</figcaption>}
              </figure>
            )}

            {block.type === "video" && (
              <figure class="detail-block detail-figure" style={`--item-delay: ${index * 70}ms`}>
                {/* #t nudges Safari to paint the first frame instead of a black box. */}
                <video src={`${block.src}#t=0.001`} controls playsinline preload="metadata"></video>
                {block.caption && <figcaption>{block.caption}</figcaption>}
              </figure>
            )}

            {block.type === "image" && (
              <figure class="detail-block detail-figure" style={`--item-delay: ${index * 70}ms`}>
                <Photo src={block.src} widths={[510, 1020, 1530]} sizes="min(510px, calc(100vw - 40px))" alt={block.alt ?? ""} loading="lazy" decoding="async" />
                {block.caption && <figcaption>{block.caption}</figcaption>}
              </figure>
            )}
          </>
        ))}
      </section>
    </article>
  </main>
</BaseLayout>
