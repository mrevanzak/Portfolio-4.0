---
import BaseLayout from "../layouts/BaseLayout.astro";
import ImageStack from "../components/ImageStack.astro";
import Signature from "../components/Signature.astro";
import { getPortfolioContent } from "../lib/content";

const { work, writing } = await getPortfolioContent({ includeBody: false });
const hasWriting = writing.length > 0;
const visibleCount = 3;
const discordUserId = "192485745087348736";
const oldPortfolios = [
  ["v3", "https://portofolio-3-0.vercel.app"],
  ["v2", "https://portofolio-2.vercel.app"],
  ["og", "https://portofolio-1-kappa.vercel.app"]
];
// Newest first, from LinkedIn. `work` is the slug of a related work entry, highlighted together on hover.
const experience = [
  { company: "AccessTime", role: "Founding Software Engineer", period: "2025 — now", summary: "Building an accessibility SaaS from scratch (automated WCAG scanning, dashboards, scheduled reports) and a multi-tenant loyalty platform for Shopify brands." },
  { company: "Niyyah", role: "Software Engineer, contract", period: "2025 — 2026", work: "niyyah", summary: "Built the Quran reader and verse-level AI Q&A in React Native and Realm, for an app with 150k+ users." },
  { company: "Apple Developer Academy", role: "iOS Engineer", period: "2025", work: "kreta", summary: "Picked from 20,000+ applicants at UC Surabaya. Shipped five iOS and iPadOS apps in SwiftUI, including Kreta, Keruh, and PewPew." },
  { company: "Hyge", role: "Software Engineer", period: "2024 — 2025", work: "airple", summary: "Sole mobile developer across four React Native apps with 5k+ users: iOS Live Activities, live location tracking, push notifications, and store releases." },
  { company: "SKK Migas", role: "Software Engineer, contract", period: "2023", summary: "Built the vendor, admin, and KKKS platforms for IOG E-commerce in Next.js, through its public launch." },
  { company: "Telkom Indonesia", role: "Software Engineer intern", period: "2023", summary: "Designed the schema and built a Laravel API for Tomps Indonesia, plus Next.js and Vue frontends." },
  { company: "DELOS", role: "Software Engineer intern", period: "2022 — 2023", summary: "Moved the codebase to TypeScript, got the team writing it, and raised Jest coverage past 90%." }
].map((job) => ({ ...job, related: job.work ? work.find((item) => item.slug === job.work) : undefined }));
---

<BaseLayout title="Rev — Design & engineering" description="Rev makes small, fast interfaces with careful motion, warm systems, and the occasional tool that feels better than it needs to.">
  <main class="page-shell route-enter-shell" data-route-shell data-route-view="home" data-route-kind="home" data-astro-transition-scope="portfolio-home">
    <a class="back-chevron" href="/" aria-label="Back home" data-expand-back hidden>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <polyline points="11.5 15.25 5.25 9 11.5 2.75" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
      </svg>
    </a>

    <header class="intro-panel" aria-labelledby="page-title" data-collapsible>
      <a class="skip-link" href="#content">Skip to content</a>
      <div class="intro-topline" style="--stagger: 0">
        <p class="kicker">Design & engineering</p>
        <a
          class="discord-status"
          href={`https://discord.com/users/${discordUserId}`}
          target="_blank"
          rel="noreferrer"
          data-discord-status
          data-status="loading"
          aria-label="Discord status: checking"
        >
          <span class="status-ring" aria-hidden="true">
            <svg class="discord-mark" viewBox="0 0 24 24">
              <path fill="currentColor" d="M19.5 5.1A17.6 17.6 0 0 0 15.1 3.8l-.2.4a12.3 12.3 0 0 1 3.3 1.7 14 14 0 0 0-9.8 0 12.8 12.8 0 0 1 3.3-1.7l-.2-.4A17.3 17.3 0 0 0 7 5.1C4.2 9.2 3.5 13.2 3.9 17.1a17.7 17.7 0 0 0 5.4 2.7l.7-1.1a11 11 0 0 1-1.7-.8l.4-.3a12.6 12.6 0 0 0 10.8 0l.4.3c-.5.3-1.1.6-1.7.8l.7 1.1a17.5 17.5 0 0 0 5.4-2.7c.5-4.5-.8-8.4-3.8-12Zm-9.4 9.6c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Zm6.4 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Z" />
            </svg>
            <img class="discord-avatar" alt="" width="40" height="40" data-discord-avatar hidden />
            <span class="copy-badge">
              <svg viewBox="0 0 12 12"><path d="M2.5 6.2 5 8.6l4.5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          </span>
          <span class="discord-copy">
            <span class="status-stat" data-status-stat>…</span>
            <span class="status-copy" data-status-copy>@revn. · on discord</span>
          </span>
        </a>
      </div>
      <h1 id="page-title" style="--stagger: 1"><Signature /></h1>
      <p class="lede" style="--stagger: 1">
        I make small, fast interfaces with <span class="accent wave"><span class="sr-only">careful motion</span>{["careful", "motion"].map((word, w) => (
          <>{w > 0 && " "}<span class="wave-word" aria-hidden="true">{[...word].map((char, i) => <span class="wave-char" style={`--i: ${w * 8 + i}`}>{char}</span>)}{w > 0 && <span class="wave-tail">,</span>}</span></>
        ))}</span> warm systems, and the occasional tool that feels better than it needs to.
      </p>
    </header>

    <section class="content-index" id="content" aria-label="Portfolio index">
      <div class="entry-divider" aria-hidden="true" data-collapsible></div>

      <section class="index-section work-transition-section" aria-labelledby="work-title" transition:name="work-section">
        <h2 id="work-title" class="work-section-title" style="--stagger: 2" transition:name="work-heading">work</h2>
        <ol class="page-list work-transition-list" data-more-list transition:name="work-list">
          {work.slice(0, visibleCount).map((item, index) => (
            <li style={`--stagger: ${3 + index}`}>
              <a class:list={["page-link", "work-transition-link", item.images?.length && "has-image-stack"]} href={item.href} data-link={item.slug} transition:name={`work-item-${item.slug ?? index}`}>
                {item.images?.length && <ImageStack images={item.images} index={index} />}
                <span class="link-copy">
                  <span class="link-title">{item.title}</span>
                </span>
                <span class="work-link-meta">{item.date}</span>
              </a>
            </li>
          ))}
          {work.length > visibleCount && (() => {
            // The More row is entry #4 in disguise: expanding morphs it into that entry.
            const peekItem = work[visibleCount];
            return (
              <li class="more-row-item" style={`--stagger: ${3 + visibleCount}`} transition:name="work-toggle-row">
                <a
                  class="page-link work-transition-link has-image-stack more-row-link"
                  href="/work"
                  aria-label="Show more work"
                  data-more-row
                  data-link={peekItem.slug}
                  data-href={peekItem.href}
                  data-title={peekItem.title}
                  data-date={peekItem.date}
                >
                  {peekItem.images?.length && <ImageStack images={peekItem.images} index={visibleCount} class="more-row-stack" />}
                  <span class="link-copy">
                    <span class="link-title" data-more-label>More</span>
                    <span class="link-title more-row-peek" aria-hidden="true">{peekItem.title}</span>
                  </span>
                  <span class="work-link-meta more-row-meta">
                    <span class="more-row-date" data-more-date></span>
                    <span class="more-row-glyph" data-more-glyph aria-hidden="true">
                      <span class="more-row-count">{work.length - visibleCount} more</span>
                      <svg class="more-row-chevron" width="13" height="13" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                        <path d="M5.625 3.75L9.375 7.5L5.625 11.25" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </span>
                </a>
              </li>
            );
          })()}
          {work.slice(visibleCount + 1).map((item, index) => (
            <li class="extra-item" style={`--stagger: ${index}`} hidden>
              <a class:list={["page-link", "work-transition-link", item.images?.length && "has-image-stack"]} href={item.href} data-link={item.slug}>
                {item.images?.length && <ImageStack images={item.images} index={visibleCount + 1 + index} />}
                <span class="link-copy">
                  <span class="link-title">{item.title}</span>
                </span>
                <span class="work-link-meta">{item.date}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <div class="entry-divider" aria-hidden="true" data-collapsible></div>

      <section class="index-section" aria-labelledby="experience-title" data-collapsible>
        <h2 id="experience-title" style={`--stagger: ${4 + visibleCount}`}>experience</h2>
        <ol class="page-list experience-list">
          {experience.map((job, index) => (
            <li style={`--stagger: ${5 + visibleCount + index}`}>
              <details class="experience-item" data-link={job.work}>
                <summary>
                  <span class="experience-company">{job.company}</span>
                  <span class="experience-role">{job.role}</span>
                  <span class="experience-period">{job.period}</span>
                  <svg class="experience-chevron" width="13" height="13" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                    <path d="M3.75 5.625L7.5 9.375L11.25 5.625" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <p class="experience-summary">{job.summary}</p>
                {/* Touch has no hover highlight, so an opened role links to its work directly. */}
                {job.related && (
                  <a class="experience-work-link" href={job.related.href}>
                    See {job.related.title}<span class="experience-work-arrow" aria-hidden="true">→</span>
                  </a>
                )}
              </details>
            </li>
          ))}
        </ol>
      </section>

      {hasWriting && (
        <>
          <div class="entry-divider" aria-hidden="true" data-collapsible></div>

          <section class="index-section" aria-labelledby="writing-title" data-collapsible>
            <h2 id="writing-title" style={`--stagger: ${4 + visibleCount}`}>Writing</h2>
            <ol class="page-list" data-more-list>
              {writing.map((item, index) => (
                <li class:list={[index >= visibleCount && "extra-item"]} style={`--stagger: ${5 + visibleCount + index}`} hidden={index >= visibleCount}>
                  <a class="page-link" href={item.href}>
                    <span class="link-title">{item.title}</span>
                    {item.summary && <span class="link-summary">{item.summary}</span>}
                  </a>
                </li>
              ))}
              {writing.length > visibleCount && (
                <li class="more-row-item" style={`--stagger: ${5 + visibleCount + Math.min(writing.length, visibleCount)}`} data-writing-toggle>
                  <button class="page-link more-row-link more-row-button" type="button" data-show-more aria-label="Show more writing">
                    <span class="link-copy">
                      <span class="link-title">More</span>
                    </span>
                    <span class="work-link-meta more-row-meta" aria-hidden="true">
                      <span class="more-row-count">{writing.length - visibleCount} more</span>
                      <svg class="more-row-chevron" width="13" height="13" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                        <path d="M3.75 5.625L7.5 9.375L11.25 5.625" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </button>
                  <button class="page-link more-row-link more-row-button" type="button" data-show-less hidden aria-label="Show less writing">
                    <span class="link-copy">
                      <span class="link-title">Less</span>
                    </span>
                    <span class="work-link-meta more-row-meta" aria-hidden="true">
                      <svg class="more-row-chevron" width="13" height="13" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                        <path d="M3.75 9.375L7.5 5.625L11.25 9.375" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </button>
                </li>
              )}
            </ol>
          </section>
        </>
      )}
    </section>

    <footer class="site-footer" data-collapsible>
      <p style={`--stagger: ${6 + visibleCount}`}>
        Older portfolios:
        {oldPortfolios.map(([label, href]) => (
          <a href={href} target="_blank" rel="noreferrer">{label}<span class="footer-arrow" aria-hidden="true">↗</span></a>
        ))}
      </p>
    </footer>
  </main>

  <script>
    const discordStatus = document.querySelector("[data-discord-status]");
    const discordStatusCopy = document.querySelector("[data-status-copy]");
    const discordStatusStat = document.querySelector("[data-status-stat]");
    const discordAvatar = document.querySelector("[data-discord-avatar]");

    type DiscordStatus = "online" | "idle" | "dnd" | "offline";
    type DiscordActivity = { type?: number; name?: string; timestamps?: { start?: number } };

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // Odometer swap: old text rolls up and out, new text rolls in from below (a plain crossfade with reduced motion).
    async function rollText(el: HTMLElement, text: string) {
      if (el.textContent === text) return;
      if (!el.textContent) {
        el.textContent = text;
        return;
      }
      if (reduceMotion.matches) {
        await el.animate([{ opacity: 0 }], { duration: 120, easing: "ease-in" }).finished;
        el.textContent = text;
        el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 160, easing: "ease-out" });
        return;
      }
      await el.animate([{ transform: "translateY(-55%)", opacity: 0, filter: "blur(2px)" }], { duration: 160, easing: "ease-in" }).finished;
      el.textContent = text;
      el.animate(
        [{ transform: "translateY(55%)", opacity: 0, filter: "blur(2px)" }, { transform: "none", opacity: 1, filter: "none" }],
        { duration: 340, easing: "cubic-bezier(0.22, 1, 0.36, 1)" }
      );
    }

    // GO Club-style stat: "2h 14m" reads better than a clock time.
    function formatElapsed(start: number) {
      const minutes = Math.max(1, Math.floor((Date.now() - start) / 60_000));
      const hours = Math.floor(minutes / 60);
      return hours ? `${hours}h ${minutes % 60}m` : `${minutes}m`;
    }

    const statusLabels: Record<DiscordStatus, string> = {
      online: "Online",
      idle: "Idle",
      dnd: "Busy",
      offline: "Offline"
    };

    async function updateDiscordStatus() {
      if (!(discordStatus instanceof HTMLAnchorElement) || !(discordStatusCopy instanceof HTMLElement) || !(discordStatusStat instanceof HTMLElement)) return;

      try {
        const request = await fetch("https://api.lanyard.rest/v1/users/192485745087348736");
        if (!request.ok) throw new Error("Discord status unavailable");

        const { data } = await request.json();
        const status = data?.discord_status as DiscordStatus | undefined ?? "offline";
        const label = statusLabels[status] ?? "Offline";
        const user = data?.discord_user;
        const activity = (data?.activities as DiscordActivity[] | undefined)?.find((item) => item?.type === 0 || item?.type === 2);
        const start = activity?.timestamps?.start;

        const doing = activity?.name ? `${activity.type === 2 ? "on" : "in"} ${activity.name}` : "on discord";
        discordHandle = user?.username ? `@${user.username}` : "";

        const stat = start ? formatElapsed(start) : label;

        discordStatus.dataset.status = status;
        discordLabel = discordHandle ? `${discordHandle} · ${doing}` : doing;
        rollText(discordStatusStat, stat);
        if (!discordStatus.hasAttribute("data-copied")) rollText(discordStatusCopy, discordLabel);
        discordStatus.setAttribute("aria-label", `Discord ${discordHandle}: ${label}, ${stat} ${doing}${discordHandle ? ". Copy username" : ""}`);

        if (discordAvatar instanceof HTMLImageElement && user?.id && user?.avatar) {
          discordAvatar.src = `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.webp?size=96`;
          discordAvatar.hidden = false;
        }
      } catch {
        discordStatus.dataset.status = "offline";
        discordStatusStat.textContent = "offline";
        discordStatusCopy.textContent = "status unavailable";
        discordStatus.setAttribute("aria-label", "Discord status unavailable");
      }
    }

    // Discord has no public profile page (logged-out visitors land on discord.com), so a click copies the username to add.
    let discordHandle = "";
    let discordLabel = "";
    let copiedTimer = 0;

    async function copyText(text: string) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Older browsers and sandboxed frames block the async clipboard; the legacy path often still works.
        const field = Object.assign(document.createElement("textarea"), { value: text });
        field.style.cssText = "position:fixed;opacity:0";
        document.body.append(field);
        field.select();
        const copied = document.execCommand("copy");
        field.remove();
        return copied;
      }
    }

    discordStatus?.addEventListener("click", async (event) => {
      if (!discordHandle || !(discordStatus instanceof HTMLElement) || !(discordStatusCopy instanceof HTMLElement)) return;
      event.preventDefault();
      const copied = await copyText(discordHandle.slice(1));
      discordStatus.setAttribute("data-copied", "");
      rollText(discordStatusCopy, copied ? `copied ${discordHandle}` : `add ${discordHandle}`);
      window.clearTimeout(copiedTimer);
      copiedTimer = window.setTimeout(() => {
        discordStatus.removeAttribute("data-copied");
        rollText(discordStatusCopy, discordLabel);
      }, 1800);
    });

    updateDiscordStatus();
    const discordStatusInterval = window.setInterval(updateDiscordStatus, 60_000);
    document.addEventListener("astro:before-swap", () => window.clearInterval(discordStatusInterval), { once: true });

    // A role and the work it produced light up together. Delegated on document so it survives ClientRouter swaps.
    let linkSource: Element | null = null;
    function setLinked(source: Element | null) {
      if (source === linkSource) return;
      linkSource = source;
      const index = document.querySelector(".content-index");
      if (!index) return;
      index.querySelectorAll("[data-linked]").forEach((el) => el.removeAttribute("data-linked"));
      const key = source?.getAttribute("data-link");
      const matches = key ? [...index.querySelectorAll(`[data-link="${CSS.escape(key)}"]`)] : [];
      const linking = matches.length > 1;
      index.toggleAttribute("data-linking", linking);
      if (linking) matches.forEach((el) => el.setAttribute("data-linked", ""));
    }
    const linkTarget = (event: Event) => (event.target instanceof Element ? event.target.closest("[data-link]") : null);
    // Touch skips it: a tap would flash the highlight, and the opened role links to its work instead.
    document.addEventListener("pointerover", (event) => { if (event.pointerType !== "touch") setLinked(linkTarget(event)); });
    document.addEventListener("pointerout", (event) => { if (!event.relatedTarget) setLinked(null); });
    document.addEventListener("focusin", (event) => { if (event.target instanceof Element && event.target.matches(":focus-visible")) setLinked(linkTarget(event)); });
    document.addEventListener("focusout", () => setLinked(null));
    document.addEventListener("astro:before-swap", () => setLinked(null));

    const sections = document.querySelectorAll(".index-section");

    sections.forEach((section) => {
      const hiddenItems = section.querySelectorAll(".extra-item");
      const showMore = section.querySelector("[data-show-more]");
      const showLess = section.querySelector("[data-show-less]");

      if (!hiddenItems.length || !(showMore instanceof HTMLButtonElement) || !(showLess instanceof HTMLButtonElement)) return;

      showMore.addEventListener("click", () => {
        hiddenItems.forEach((item) => {
          if (item instanceof HTMLElement) item.hidden = false;
        });
        section.setAttribute("data-expanded", "true");
        showMore.hidden = true;
        showLess.hidden = false;
        showLess.focus({ preventScroll: true });
      });

      showLess.addEventListener("click", () => {
        hiddenItems.forEach((item) => {
          if (item instanceof HTMLElement) item.hidden = true;
        });
        section.removeAttribute("data-expanded");
        showLess.hidden = true;
        showMore.hidden = false;
        showMore.focus({ preventScroll: true });
        section.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });
  </script>
</BaseLayout>
