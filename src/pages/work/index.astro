---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPortfolioContent } from "../../lib/content";

const { work } = await getPortfolioContent({ includeBody: false });
---

<BaseLayout title="Work — Rev" description="Selected work by Rev.">
  <main class="page-shell route-enter-shell" data-route-shell data-route-view="work" data-route-kind="work" data-astro-transition-scope="portfolio-work">
    <header class="intro-panel stagger-in work-transition-header" aria-labelledby="page-title">
      <a class="back-pill" href="/">← Back</a>
      <p class="kicker">Selected work</p>
      <h1 id="page-title">Work</h1>
      <p class="lede">A compact index of interfaces, systems, and small tools.</p>
    </header>

    <section class="content-index" id="content" aria-label="Selected work">
      <div class="entry-divider" aria-hidden="true"></div>

      <section class="index-section stagger-in work-transition-section" style="--delay: 80ms" aria-labelledby="work-list-title" transition:name="work-section">
        <h2 id="work-list-title" class="work-section-title" transition:name="work-heading">work</h2>
        <ol class="page-list work-transition-list" transition:name="work-list">
          {work.map((item, index) => (
            <li style={`--item-delay: ${120 + index * 45}ms`}>
              <a class:list={["page-link", "work-transition-link", item.images?.length && "has-image-stack"]} href={item.href} transition:name={`work-item-${item.slug ?? index}`}>
                {item.images?.length && (
                  <span class="image-stack" aria-hidden="true">
                    {item.images.slice(0, 3).map((image, imageIndex) => (
                      <span class="image-stack-card" style={`--stack-index: ${imageIndex}`}>
                        <img src={image.src} alt="" loading="lazy" decoding="async" />
                      </span>
                    ))}
                  </span>
                )}
                <span class="link-copy">
                  <span class="link-title">{item.title}</span>
                </span>
                <span class="work-link-meta">{item.date}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    </section>
  </main>
</BaseLayout>
