---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Rev",
  description = "Design, engineering, and writing."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1917" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add("hover-cold");
      let firstX = -1;
      let firstY = -1;

      function getRoot() {
        return document.documentElement;
      }

      function cleanPath(url) {
        try {
          const pathname = new URL(url, window.location.origin).pathname.replace(/\/$/, "");
          return pathname || "/";
        } catch {
          return "/";
        }
      }

      function isDetail(path) {
        return /^\/(work|writing)\/.+/.test(path);
      }

      function getRouteMotion(fromUrl, toUrl) {
        const fromPath = cleanPath(fromUrl);
        const toPath = cleanPath(toUrl);

        if (fromPath === "/" && toPath === "/work") return "home-to-work";
        if (fromPath === "/work" && toPath === "/") return "work-to-home";
        if (!isDetail(fromPath) && isDetail(toPath)) return "to-detail";
        if (isDetail(fromPath) && !isDetail(toPath)) return "from-detail";
        return "default";
      }

      function applyMotionDebug(target = document.documentElement) {
        const params = new URLSearchParams(window.location.search);

        if (params.get("motion") === "slow") {
          target.dataset.motionDebug = "slow";
        } else {
          delete target.dataset.motionDebug;
        }
      }

      function syncRouteContext() {
        const shell = document.querySelector("[data-route-shell]");
        const routeView = shell?.getAttribute("data-route-view") ?? "home";
        const routeKind = shell?.getAttribute("data-route-kind") ?? "home";
        const root = getRoot();

        root.dataset.routeView = routeView;
        root.dataset.routeKind = routeKind;
        root.classList.remove("route-view-home", "route-view-work", "route-view-detail", "route-kind-home", "route-kind-work", "route-kind-writing");
        root.classList.add(`route-view-${routeView}`, `route-kind-${routeKind}`);
        applyMotionDebug();
      }

      function armHover() {
        getRoot().classList.remove("hover-cold");
        window.removeEventListener("pointermove", onFirstPointerMove);
        window.removeEventListener("pointerdown", armHover);
      }
      function onFirstPointerMove(event) {
        if (firstX < 0) {
          firstX = event.clientX;
          firstY = event.clientY;
          return;
        }
        if (Math.abs(event.clientX - firstX) + Math.abs(event.clientY - firstY) > 12) {
          armHover();
        }
      }
      if (!window.__portfolioRouteMotionBound) {
        window.__portfolioRouteMotionBound = true;
        document.addEventListener("astro:before-preparation", (event) => {
          const fromUrl = event.from?.href ?? window.location.href;
          const toUrl = event.to?.href ?? window.location.href;
          const routeMotion = getRouteMotion(fromUrl, toUrl);
          const root = getRoot();

          root.dataset.routeMotion = routeMotion;

          if (routeMotion === "work-to-home" && "direction" in event) {
            event.direction = "back";
          } else if (routeMotion === "home-to-work" && "direction" in event) {
            event.direction = "forward";
          } else if (routeMotion === "to-detail" && "direction" in event) {
            event.direction = "forward";
          } else if (routeMotion === "from-detail" && "direction" in event) {
            event.direction = "back";
          }
        });
        document.addEventListener("astro:before-swap", (event) => {
          const root = getRoot();
          event.newDocument.documentElement.dataset.routeMotion = root.dataset.routeMotion ?? "default";

          if (root.dataset.motionDebug === "slow") {
            event.newDocument.documentElement.dataset.motionDebug = "slow";
          } else {
            delete event.newDocument.documentElement.dataset.motionDebug;
          }
        });
        window.addEventListener("pointermove", onFirstPointerMove, { passive: true });
        window.addEventListener("pointerdown", armHover, { passive: true });
        document.addEventListener("astro:page-load", syncRouteContext);
        document.addEventListener("astro:after-swap", syncRouteContext);
      }

      applyMotionDebug();

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", syncRouteContext, { once: true });
      } else {
        syncRouteContext();
      }
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      // Work detail opens as an overlay above the index (like ja.mt): the index never unmounts,
      // so the hero can fly out of its stack card and back into it without a page swap.
      (() => {
        if (window.__workOverlay) return;
        window.__workOverlay = true;

        const DURATION = 530;
        const root = document.documentElement;
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

        const bez = (x1, y1, x2, y2) => {
          const cx = 3 * x1, bx = 3 * (x2 - x1) - cx, ax = 1 - cx - bx;
          const cy = 3 * y1, by = 3 * (y2 - y1) - cy, ay = 1 - cy - by;
          return (x) => {
            let lo = 0, hi = 1, t = x;
            for (let i = 0; i < 24; i++) {
              const v = ((ax * t + bx) * t + cx) * t;
              if (Math.abs(v - x) < 1e-5) break;
              if (v < x) lo = t; else hi = t;
              t = (lo + hi) / 2;
            }
            return ((ay * t + by) * t + cy) * t;
          };
        };
        const E_ROT = bez(0.4, 0.9, 0.25, 1);
        const E_Y = bez(0.35, 1, 0.25, 1);
        const E_X = bez(0.45, 0.9, 0.25, 1);
        const E_SIZE = bez(0.35, 0.95, 0.25, 1);
        const REVEAL_EASE = "cubic-bezier(0.22, 0.03, 0.26, 1)";

        const lerp = (a, b, p) => a + (b - a) * p;
        const speed = () => parseFloat(getComputedStyle(root).getPropertyValue("--speed")) || 1;
        const wait = (ms) => new Promise((r) => setTimeout(r, ms * speed()));
        const clean = (u) => new URL(u, location.href).pathname.replace(/\/+$/, "") || "/";
        const isWork = (path) => /^\/work\/[^/]+$/.test(path);

        const pages = new Map();
        const load = (path) => {
          if (!pages.has(path)) {
            pages.set(path, fetch(path)
              .then((r) => (r.ok ? r.text() : Promise.reject(r.status)))
              .then((html) => new DOMParser().parseFromString(html, "text/html"))
              .catch((err) => { pages.delete(path); throw err; }));
          }
          return pages.get(path);
        };

        // The last card in the stack paints on top.
        const topCard = (link) => link.querySelector(".image-stack-card:last-child .polaroid-card");
        const stackLink = (path) =>
          [...document.querySelectorAll("a.has-image-stack")].find((a) => clean(a.href) === path);

        const rotOf = (el) => {
          const v = getComputedStyle(el).transform.match(/matrix\(([^)]+)\)/);
          if (!v) return 0;
          const [a, b] = v[1].split(",").map(Number);
          return Math.atan2(b, a);
        };
        // Unrotated box around the element's visual center (getBoundingClientRect inflates rotated boxes).
        const cardRect = (card) => {
          const r = card.getBoundingClientRect();
          const w = card.offsetWidth, h = card.offsetHeight;
          const rot = rotOf(card) + rotOf(card.parentElement); // own tilt + fan
          return { x: r.left + r.width / 2 - w / 2, y: r.top + r.height / 2 - h / 2, w, h, rot, b: 2.8 };
        };
        const heroTarget = () => {
          const col = Math.min(innerWidth, 550), w = col - 40;
          return { x: (innerWidth - col) / 2 + 20, y: 80, w, h: Math.round(((w - 29) * 3) / 5 + 29), rot: 0, b: 14.5 };
        };

        function paint(ctx, dpr, r, img, k) {
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.clearRect(0, 0, innerWidth, innerHeight);
          ctx.translate(r.x + r.w / 2, r.y + r.h / 2);
          ctx.rotate(r.rot);
          ctx.fillStyle = "#fff";
          ctx.fillRect(-r.w / 2, -r.h / 2, r.w, r.h);
          const iw = r.w - 2 * r.b, ih = r.h - 2 * r.b;
          if (iw <= 0 || ih <= 0) return;
          ctx.save();
          ctx.beginPath();
          ctx.rect(-iw / 2, -ih / 2, iw, ih);
          ctx.clip();
          if (img.naturalWidth) {
            const s = Math.max(iw / img.naturalWidth, ih / img.naturalHeight);
            const dw = img.naturalWidth * s, dh = img.naturalHeight * s;
            ctx.drawImage(img, -dw / 2, -dh / 2, dw, dh);
          }
          // Inner vignette: a shadow cast inward by a frame around the photo.
          ctx.shadowColor = "rgba(0, 0, 0, 0.08)";
          ctx.shadowBlur = lerp(1, 4, k) * dpr;
          ctx.beginPath();
          ctx.rect(-iw / 2 - 100, -ih / 2 - 100, iw + 200, ih + 200);
          ctx.rect(-iw / 2, -ih / 2, iw, ih);
          ctx.fillStyle = "#000";
          ctx.fill("evenodd");
          ctx.restore();
        }

        function shade(el, r, k) {
          const s = el.style;
          s.width = r.w + "px";
          s.height = r.h + "px";
          s.transform = `translate(${r.x}px, ${r.y}px) rotate(${r.rot}rad)`;
          s.boxShadow = `0 ${lerp(1.5, 5.833, k)}px ${lerp(2, 8.75, k)}px ${lerp(-0.25, -2.917, k)}px rgba(0, 0, 0, ${lerp(0.18, 0.25, k)})`;
        }

        // Draws the photo flying from -> to on a full-viewport canvas. `to` may be mutated mid-flight
        // to retarget. Resolves on the last frame, which stays painted until fadeAway().
        function fly(from, to, img, opening, onFirstFrame) {
          const canvas = Object.assign(document.createElement("canvas"), { className: "morph-canvas" });
          const shadow = Object.assign(document.createElement("div"), { className: "morph-shadow" });
          canvas.setAttribute("aria-hidden", "true");
          shadow.setAttribute("aria-hidden", "true");
          document.body.append(shadow, canvas);
          const dpr = Math.min(devicePixelRatio || 1, 2);
          canvas.width = Math.round(innerWidth * dpr);
          canvas.height = Math.round(innerHeight * dpr);
          const ctx = canvas.getContext("2d");
          const dur = DURATION * speed();
          let t0 = 0;
          return new Promise((resolve) => {
            const frame = (now) => {
              if (!t0) { t0 = now; onFirstFrame?.(); }
              const p = Math.min(1, (now - t0) / dur);
              const pR = E_ROT(p), pS = opening ? E_SIZE(p) : pR;
              const w = lerp(from.w, to.w, pS), h = lerp(from.h, to.h, pS);
              const cx = lerp(from.x + from.w / 2, to.x + to.w / 2, E_X(p));
              const cy = lerp(from.y + from.h / 2, to.y + to.h / 2, E_Y(p));
              const r = { x: cx - w / 2, y: cy - h / 2, w, h, rot: lerp(from.rot, to.rot, pR), b: lerp(from.b, to.b, pR) };
              const k = opening ? pR : 1 - pR;
              paint(ctx, dpr, r, img, k);
              shade(shadow, r, k);
              if (p < 1) requestAnimationFrame(frame);
              else resolve({ canvas, shadow });
            };
            requestAnimationFrame(frame);
          });
        }

        function fadeAway({ canvas, shadow }, then) {
          canvas.style.transition = "opacity 150ms ease-out";
          canvas.style.opacity = "0";
          setTimeout(() => { canvas.remove(); shadow.remove(); then?.(); }, 160);
        }

        function tuck(link, top, on) {
          link.querySelectorAll(".image-stack-card").forEach((c) => {
            c.getAnimations().forEach((a) => a.id === "stack-tuck" && a.cancel());
            if (!on || c.contains(top)) return;
            const rest = `translate(${c.style.getPropertyValue("--rest-tx")}, ${c.style.getPropertyValue("--rest-ty")})`;
            c.animate(
              [{ transform: getComputedStyle(c).transform }, { transform: rest }],
              { id: "stack-tuck", duration: 350 * speed(), easing: "cubic-bezier(0.34, 1.4, 0.64, 1)", fill: "forwards" }
            );
          });
        }

        let st = null;

        async function open(link, path, push = true) {
          const card = topCard(link);
          const img = card?.querySelector("img");
          const shell = document.querySelector("[data-route-shell]");
          if (!card || !img?.naturalWidth || !shell) return false;

          const s = (st = { path, base: clean(location.href), title: document.title, link, card, shell, phase: "opening" });
          const page = load(path);
          const to = heroTarget();
          const flight = fly(cardRect(card), to, img, true, () => (card.style.visibility = "hidden"));
          tuck(link, card, true);
          root.classList.add("overlay-open");
          shell.classList.add("blur-locked");
          s.shellAnim = shell.animate(
            [
              { opacity: 1, filter: "blur(0px)" },
              { opacity: 0.4, filter: "blur(6px)", offset: 0.55 },
              { opacity: 0, filter: "blur(6px)" }
            ],
            { duration: 470 * speed(), delay: 60 * speed(), easing: "cubic-bezier(0.25, 0.1, 0.25, 1)", fill: "forwards" }
          );
          if (push) history.pushState({ ...history.state, overlay: path }, "", path);

          let doc;
          try {
            [doc] = await Promise.all([page, wait(200)]);
          } catch {
            location.assign(path);
            return true;
          }
          if (st !== s) return true;
          mount(s, doc, to);
          // If the fetch outlived the flight, the canvas has been parked on its last frame.
          land(s, await flight);
          return true;
        }

        function mount(s, doc, to) {
          const src = doc.querySelector("[data-route-shell]");
          s.backdrop = Object.assign(document.createElement("div"), { className: "detail-overlay-backdrop" });
          s.overlay = Object.assign(document.createElement("div"), { className: "detail-overlay" });
          s.overlay.setAttribute("role", "dialog");
          s.overlay.setAttribute("aria-modal", "true");
          s.overlay.setAttribute("aria-label", doc.title);
          s.overlay.innerHTML = `<div class="detail-shell">${src ? src.innerHTML : ""}</div>`;
          document.body.append(s.backdrop, s.overlay);
          document.title = doc.title;
          s.backdrop.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 400 * speed(), easing: "ease-out", fill: "forwards" });

          s.hero = s.overlay.querySelector(".detail-hero");
          s.heroImg = s.hero?.querySelector("img");
          s.early = s.overlay.querySelectorAll(".detail-kicker, .detail-header h1");
          s.late = s.overlay.querySelectorAll(".detail-meta, .detail-divider, .detail-body");
          [...s.early, ...s.late].forEach((el) => (el.style.opacity = "0"));
          if (s.hero) {
            s.hero.style.visibility = "hidden";
            s.hero.style.boxShadow = "none";
            const r = s.hero.getBoundingClientRect();
            Object.assign(to, { x: r.left, y: r.top, w: r.width, h: r.height });
          }
        }

        function land(s, flight) {
          if (st !== s) return fadeAway(flight);
          if (s.hero) s.hero.style.visibility = "";
          fadeAway(flight, () => s.hero && (s.hero.style.boxShadow = ""));
          const reveal = (els, delay) => els.forEach((el) =>
            el.animate([{ opacity: 0, filter: "blur(4px)" }, { opacity: 1, filter: "blur(0px)" }],
              { duration: 500 * speed(), delay: delay * speed(), easing: REVEAL_EASE, fill: "both" }));
          reveal(s.early, 250);
          reveal(s.late, 400);
          [...s.early, ...s.late].forEach((el) => (el.style.opacity = ""));
          s.overlay.querySelector(".back-chevron")?.focus({ preventScroll: true });
          s.phase = "open";
          sync();
        }

        async function close() {
          const s = st;
          if (!s) return;
          if (s.phase !== "open") return; // land() or done() re-syncs
          s.phase = "closing";
          s.overlay.style.pointerEvents = "none";
          const out = [{ opacity: 1, filter: "blur(0px)" }, { opacity: 0, filter: "blur(6px)" }];
          s.overlay.querySelectorAll(".detail-header, .detail-divider, .detail-body, .back-chevron")
            .forEach((el) => el.animate(out, { duration: 150 * speed(), easing: "ease-in", fill: "forwards" }));
          await wait(150);
          if (st !== s) return;

          const ease = "cubic-bezier(0.22, 1, 0.36, 1)";
          s.shell.classList.remove("blur-locked");
          s.shellAnim.cancel();
          s.shell.animate([{ opacity: 0, filter: "blur(6px)" }, { opacity: 1, filter: "blur(0px)" }], { duration: 450 * speed(), easing: ease });
          s.backdrop.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 450 * speed(), easing: ease, fill: "forwards" });

          const done = () => {
            s.card.style.visibility = "";
            tuck(s.link, s.card, false);
            s.overlay.remove();
            s.backdrop.remove();
            root.classList.remove("overlay-open");
            document.title = s.title;
            s.link.focus({ preventScroll: true });
            st = null;
            sync();
          };
          if (!s.hero || !s.heroImg) return done();
          const h = s.hero.getBoundingClientRect();
          const flight = await fly(
            { x: h.left, y: h.top, w: h.width, h: h.height, rot: 0, b: 14.5 },
            cardRect(s.card), s.heroImg, false,
            () => (s.overlay.firstElementChild.style.display = "none")
          );
          done();
          fadeAway(flight);
        }

        // --- Home work list expands in place (the "More" row) ---
        const SPRING = "linear(0, .1052, .3155, .532, .7112, .8414, .9265, .9765, 1.0023, 1.013, 1.0151, 1.0133, 1.01, 1.0068, 1.0041, 1.0022, 1.001, 1)";
        const OUT_QUAD = "cubic-bezier(0.25, 0.46, 0.45, 0.94)";
        const IN_QUAD = "cubic-bezier(0.55, 0.085, 0.68, 0.53)";
        const SLIDE = "cubic-bezier(0.35, 0.95, 0.25, 1)";
        const timed = (ms, delay = 0, easing = "linear") => ({ duration: ms * speed(), delay: delay * speed(), easing, fill: "both" });

        // Letter-by-letter swap: old glyphs float up and out, new ones rise in.
        function morphText(el, text, ms) {
          const token = (el.dataset.morph = String(Math.random()));
          const chars = (str) => [...str].map((c) => Object.assign(document.createElement("span"), { className: "morph-char", textContent: c }));
          el.querySelector(":scope > .morph-exit")?.remove(); // an interrupted morph's leftovers
          const cs = getComputedStyle(el);
          const gone = chars(el.textContent);
          const exit = Object.assign(document.createElement("span"), { className: "morph-exit" });
          exit.setAttribute("aria-hidden", "true");
          exit.style.color = cs.color;
          exit.style.fontStyle = cs.fontStyle;
          exit.append(...gone);
          const born = chars(text);
          el.replaceChildren(...born, exit);
          const run = (list, out) => {
            const step = (ms * 0.3) / (list.length || 1);
            const off = (y) => `translateY(${y}em) scale(0.6) rotate(2deg)`;
            return list.map((c, i) => c.animate(
              {
                opacity: out ? [1, 0] : [0, 1],
                transform: out ? ["none", off(-0.35)] : [off(0.35), "none"],
                filter: out ? ["blur(0px)", "blur(0.1em)"] : ["blur(0.1em)", "blur(0px)"]
              },
              timed(ms, i * step, SPRING)
            ).finished);
          };
          Promise.all([...run(gone, true), ...run(born, false)])
            .then(() => { if (el.dataset.morph === token) el.textContent = text; })
            .catch(() => {});
        }

        let listBusy = false;
        const listParts = () => {
          const shell = document.querySelector('[data-route-shell][data-route-view="home"]');
          const row = shell?.querySelector("[data-more-row]");
          if (!row) return null;
          const section = row.closest(".index-section");
          return {
            shell, row, section,
            hide: [...shell.querySelectorAll("[data-collapsible]")],
            extras: [...section.querySelectorAll(".extra-item")],
            back: shell.querySelector("[data-expand-back]"),
            label: row.querySelector("[data-more-label]"),
            date: row.querySelector("[data-more-date]"),
            glyph: row.querySelector("[data-more-glyph]")
          };
        };
        const isExpanded = () => !!document.querySelector('[data-route-shell][data-expanded]');

        function settleList() {
          listBusy = false;
          sync();
        }

        function expand(push = true) {
          const ui = listParts();
          if (!ui || listBusy || isExpanded()) return;
          listBusy = true;
          if (push) history.pushState({ ...history.state, expanded: "work" }, "", "/work");
          ui.shell.dataset.title = document.title;
          document.title = "Work — Rev";
          scrollTo({ top: 0, behavior: "instant" });

          // Lift the intro and other sections out of flow where they stand, then fade them.
          const box = ui.shell.getBoundingClientRect();
          const fromY = ui.section.getBoundingClientRect().top;
          const lifted = ui.hide.map((el) => {
            const r = el.getBoundingClientRect(), cs = getComputedStyle(el);
            return { el, r, opacity: cs.opacity, filter: cs.filter === "none" ? "blur(0px)" : cs.filter };
          });
          for (const { el, r } of lifted) {
            Object.assign(el.style, { position: "absolute", top: `${r.top - box.top}px`, left: `${r.left - box.left}px`, width: `${r.width}px`, margin: "0" });
            el.inert = true;
          }
          for (const { el, opacity, filter } of lifted) {
            el.animate([{ opacity, filter }, { opacity: 0, filter: "blur(6px)" }], { ...timed(250, 0, OUT_QUAD), fill: "forwards" });
          }
          ui.shell.dataset.expanded = "work";
          ui.extras.forEach((li) => (li.hidden = false));
          ui.back.getAnimations().forEach((a) => a.cancel());
          ui.back.hidden = false;
          ui.section.animate([{ transform: `translateY(${fromY - ui.section.getBoundingClientRect().top}px)` }, { transform: "none" }], timed(500, 100, SLIDE));

          // The More row becomes the entry it was previewing.
          ui.row.classList.remove("more-row-link");
          ui.row.querySelector(".image-stack")?.classList.remove("more-row-stack");
          ui.row.href = ui.row.dataset.href;
          ui.row.removeAttribute("aria-label");
          morphText(ui.label, ui.row.dataset.title, 280);
          ui.glyph.animate([{ opacity: 1, filter: "blur(0px)" }, { opacity: 0, filter: "blur(5px)" }], { ...timed(180), fill: "forwards" });
          setTimeout(() => {
            ui.glyph.hidden = true;
            morphText(ui.date, ui.row.dataset.date, 320);
          }, 210 * speed());

          setTimeout(() => {
            for (const { el } of lifted) {
              el.getAnimations().forEach((a) => a.cancel());
              el.removeAttribute("style");
            }
            settleList();
          }, 600 * speed());
        }

        function collapse() {
          const ui = listParts();
          if (!ui || listBusy || !isExpanded()) return;
          listBusy = true;
          document.title = ui.shell.dataset.title || document.title;
          scrollTo({ top: 0, behavior: "instant" });

          const fromY = ui.section.getBoundingClientRect().top;
          ui.extras.forEach((li) => li.animate([{ opacity: 1, filter: "blur(0px)" }, { opacity: 0, filter: "blur(6px)" }], { ...timed(300, 0, IN_QUAD), fill: "forwards" }));
          ui.back.animate([{ scale: 1, opacity: 1 }, { scale: 0, opacity: 0 }], { ...timed(180, 0, "ease-in"), fill: "forwards" })
            .finished.then(() => { if (!isExpanded()) ui.back.hidden = true; }).catch(() => {});

          delete ui.shell.dataset.expanded;
          ui.hide.forEach((el) => {
            el.inert = false;
            el.animate([{ opacity: 0, filter: "blur(8px)" }, { opacity: 1, filter: "blur(0px)" }], timed(500, 450, OUT_QUAD));
          });
          ui.section.animate([{ transform: `translateY(${fromY - ui.section.getBoundingClientRect().top}px)` }, { transform: "none" }], timed(500, 350, SLIDE));

          setTimeout(() => ui.extras.forEach((li) => {
            li.hidden = true;
            li.getAnimations().forEach((a) => a.cancel());
          }), 300 * speed());

          // Back into a More row once the slide is a third of the way home.
          setTimeout(() => {
            ui.row.classList.add("more-row-link");
            ui.row.querySelector(".image-stack")?.classList.add("more-row-stack");
            ui.row.href = "/work";
            ui.row.setAttribute("aria-label", "Show more work");
            morphText(ui.label, "More", 280);
            morphText(ui.date, "", 320);
            setTimeout(() => {
              ui.glyph.hidden = false;
              ui.glyph.animate([{ opacity: 0, filter: "blur(5px)" }, { opacity: 1, filter: "blur(0px)" }], timed(180));
            }, 320 * speed());
          }, 525 * speed());

          setTimeout(settleList, 950 * speed());
        }

        // Entries this script pushed are popped; anything else (e.g. reached via forward) is rewritten in place.
        function leaveTo(path) {
          if (history.state?.overlay || (history.state?.expanded && path === "/")) return history.back();
          history.replaceState({ ...history.state, overlay: undefined, expanded: undefined }, "", path);
          sync();
        }
        const requestCollapse = () => leaveTo("/");

        const requestClose = () => leaveTo(st.base);

        // Make the page match the URL: overlay open or not, home list expanded or not.
        // Runs on back/forward and again whenever an animation settles.
        function sync() {
          const here = clean(location.href);
          const wantOverlay = isWork(here) ? here : null;
          if (st) {
            if (st.path !== wantOverlay) close();
            return;
          }
          if (listBusy) return;
          if (listParts()) {
            const wantExpanded = here === "/work" || (!!wantOverlay && !!history.state?.expanded);
            if (wantExpanded !== isExpanded()) return wantExpanded ? expand(false) : collapse();
          }
          const link = wantOverlay && !reduced.matches && stackLink(wantOverlay);
          // Card photo not loaded yet: show the real page rather than nothing.
          if (link) open(link, wantOverlay, false).then((ok) => ok || location.reload());
        }

        // Whether this document can show the URL in place (else ClientRouter swaps pages).
        function ours() {
          const here = clean(location.href);
          if (reduced.matches && !st) return false;
          if (st && here === st.base) return true;
          if (isWork(here)) return st?.path === here || !!stackLink(here);
          return !!listParts() && (here === "/" || here === "/work");
        }

        document.addEventListener("click", (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          if (st) {
            if (e.target === st.overlay || e.target.closest?.(".detail-overlay .back-chevron")) {
              e.preventDefault();
              requestClose();
            }
            return;
          }
          if (reduced.matches) return;
          if (e.target.closest?.("[data-expand-back]")) {
            e.preventDefault();
            requestCollapse();
            return;
          }
          if (e.target.closest?.("[data-more-row]") && !isExpanded()) {
            e.preventDefault();
            expand();
            return;
          }
          const link = e.target.closest?.("a.has-image-stack");
          if (!link || !isWork(clean(link.href))) return;
          const img = topCard(link)?.querySelector("img");
          if (!img?.naturalWidth) return;
          e.preventDefault();
          open(link, clean(link.href));
        }, { capture: true });

        // Registered before ClientRouter's module runs, so this can stop it from swapping pages.
        window.addEventListener("popstate", (e) => {
          if (!ours()) return;
          e.stopImmediatePropagation();
          sync();
        }, { capture: true });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && st) requestClose();
        });

        const warm = (e) => {
          const link = e.target.closest?.("a.has-image-stack");
          if (link && isWork(clean(link.href))) load(clean(link.href)).catch(() => {});
        };
        document.addEventListener("pointerover", warm, { passive: true });
        document.addEventListener("focusin", warm);

        // A real navigation from inside the overlay replaces the whole body.
        document.addEventListener("astro:before-swap", () => {
          st = null;
          listBusy = false;
          root.classList.remove("overlay-open");
        });
      })();
    </script>
  </body>
</html>
